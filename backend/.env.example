# ===========================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# ===========================================

# -------------------------------------------
# APPLICATION
# -------------------------------------------
NODE_ENV=production
PORT=3000

# -------------------------------------------
# DATABASE (Railway provides these when you link MySQL service)
# -------------------------------------------
# DB_HOST=mysql
# DB_PORT=3306
# DB_USERNAME=saas_user
# DB_PASSWORD=saas_pass
# DB_DATABASE=saas_crm

# Or use DATABASE_URL (Railway provides this automatically)
# DATABASE_URL=mysql://user:pass@host:port/db

# -------------------------------------------
# CORS ORIGINS - Web Frontend + Mobile Apps
# -------------------------------------------
# Production frontend URL (Railway domain or custom domain)
FRONTEND_URL=https://your-frontend.railway.app

# Additional web origins (comma-separated)
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# Mobile app origins (comma-separated) - for custom mobile schemes
# MOBILE_CORS_ORIGINS=capacitor://localhost,ionic://localhost,myapp://localhost

# -------------------------------------------
# JWT AUTHENTICATION (REQUIRED - CHANGE IN PRODUCTION!)
# -------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=your-64-character-random-secret-key-minimum-32-chars
JWT_EXPIRES_IN=1d

REFRESH_TOKEN_SECRET=another-64-character-random-secret-key-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# -------------------------------------------
# DATABASE MIGRATIONS
# -------------------------------------------
DB_MIGRATIONS_RUN=true
DB_SYNCHRONIZE=false
SEED_DEMO_DATA=false

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
THROTTLE_DISABLED=false

# -------------------------------------------
# STRIPE (Billing)
# -------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# -------------------------------------------
# GOOGLE OAUTH
# -------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/auth/google/callback

# -------------------------------------------
# EMAIL (SMTP - SendGrid, Mailgun, Resend, etc.)
# -------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Lead to Doctor

# -------------------------------------------
# MOBILE APP CONFIG (Optional)
# -------------------------------------------
MOBILE_APP_PACKAGE=com.yourcompany.leadtodoc
MOBILE_MIN_VERSION=1.0.0
MOBILE_FORCE_UPDATE_VERSION=1.0.0

# -------------------------------------------
# TRUST PROXY (for Railway/Load Balancer)
# -------------------------------------------
# Number of proxy hops (1 for Railway, 2 if behind Cloudflare + Railway)
TRUST_PROXY=1

# -------------------------------------------
# LOGGING
# -------------------------------------------
LOG_LEVEL=info