# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to .env.local or .env.production
# ===========================================

# -------------------------------------------
# API URL (Backend)
# -------------------------------------------
# Production: Railway backend domain
NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api

# Local development
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# -------------------------------------------
# APP CONFIG
# -------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-frontend.railway.app
NEXT_PUBLIC_APP_NAME=Lead to Doctor

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
NEXT_PUBLIC_ENABLE_MOBILE_SYNC=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

# -------------------------------------------
# EXTERNAL SERVICES (Client-side keys only)
# -------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -------------------------------------------
# ANALYTICS (Optional)
# -------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx